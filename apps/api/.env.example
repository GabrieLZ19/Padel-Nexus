PORT=4000
FRONTEND_URL=http://localhost:3000
# URL publica de esta API (sin slash final). Arma notification_url de Mercado Pago.
# Produccion (Render): https://padel-nexus-875c.onrender.com
BACKEND_URL=http://localhost:4000
# Produccion: https://www.padelnexus.app (siempre con https://)
# CORS_EXTRA_ORIGINS=https://padel-nexus-eosin.vercel.app
RECUPERACION_PASSWORD_REDIRECT_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_API_KEY=

RESEND_API_KEY=
RESEND_FROM_AUTH=Padel Nexus <no-responder@padelnexus.app>
RESEND_CAMPAIGN_FROM_EMAIL=info@padelnexus.app
# Solo true cuando Resend tenga plan con cuota suficiente para campañas masivas.
RESEND_CAMPANA_EMAIL_HABILITADO=false

WHATSAPP_CAMPANAS_HABILITADO=false

# Mercado Pago (produccion: APP_USR-... desde Tus integraciones > Credenciales)
MP_ACCESS_TOKEN=
# Firma secreta de Webhooks (Tus integraciones > Webhooks > Configurar notificacion).
# Obligatoria en produccion si MP_ACCESS_TOKEN esta configurado (valida x-signature).
# La URL general del panel puede apuntar a reservas; cada preferencia define su propia notification_url.
MP_WEBHOOK_SECRET=

# Respaldo ops si la federación no cargó datos en el CRM (opcional)
# LICENCIA_PAGO_ALIAS=
# LICENCIA_PAGO_CBU=
# LICENCIA_PAGO_TITULAR=
