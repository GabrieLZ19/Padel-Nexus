# URL base de la API (incluye /api)
# En local (Expo Go reemplaza localhost por la IP de tu PC cuando aplica):
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Si el auto-detect falla, usá tu IP LAN explícita, ej:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api

# Producción: NO commitear .env. Configurá EXPO_PUBLIC_API_URL
# como variable/secreto en EAS (preview/production).
