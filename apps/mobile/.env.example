# URL base de la API (incluye /api)
# En Expo Go con dispositivo físico podés dejar localhost:
# la app reemplaza automáticamente por la IP de tu PC (misma que Metro).
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Si el auto-detect falla, usá tu IP LAN explícita, ej:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
