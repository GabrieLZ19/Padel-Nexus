{
  "expo": {
    "name": "Padel Nexus",
    "slug": "padel-nexus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "padelnexus",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Padel Nexus usa tu ubicación para mostrar canchas cercanas en el mapa."
      }
    },
    "android": {
      "package": "com.gabrielz20.padelnexus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#CBFE01"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Padel Nexus usa tu ubicación para mostrar canchas cercanas en el mapa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Padel Nexus necesita acceso a tus fotos para tu avatar de jugador.",
          "cameraPermission": "Padel Nexus necesita acceso a la cámara para tu foto de perfil."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "position": "absolute",
        "visibility": "hidden",
        "behavior": "overlay-swipe",
        "backgroundColor": "#000000"
      },
      "eas": {
        "projectId": "0a026a65-e085-42cc-ae8d-0009e40463f9"
      }
    },
    "owner": "gabrielz20"
  }
}
